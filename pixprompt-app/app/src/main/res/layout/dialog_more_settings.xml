<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bottom_sheet_bg"
    android:orientation="vertical"
    android:paddingBottom="24dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="20dp">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="More &amp; Settings"
            android:textColor="@color/text_primary"
            android:textSize="19sp"
            android:textStyle="bold" />

        <ImageView
            android:id="@+id/closeMenuButton"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:src="@drawable/ic_close" />
    </LinearLayout>

    <!-- Row template repeated -->
    <LinearLayout
        android:id="@+id/rowWhatsapp"
        style="@style/MenuRow">
        <FrameLayout style="@style/MenuRowIconBg">
            <ImageView style="@style/MenuRowIcon" android:src="@drawable/ic_whatsapp" />
        </FrameLayout>
        <TextView style="@style/MenuRowText" android:text="Join Our WhatsApp Channel" />
        <ImageView style="@style/MenuRowChevron" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/rowRate"
        style="@style/MenuRow">
        <FrameLayout style="@style/MenuRowIconBg">
            <ImageView style="@style/MenuRowIcon" android:src="@drawable/ic_star" />
        </FrameLayout>
        <TextView style="@style/MenuRowText" android:text="Rate Us" />
        <ImageView style="@style/MenuRowChevron" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/rowShare"
        style="@style/MenuRow">
        <FrameLayout style="@style/MenuRowIconBg">
            <ImageView style="@style/MenuRowIcon" android:src="@drawable/ic_share" />
        </FrameLayout>
        <TextView style="@style/MenuRowText" android:text="Share Our App" />
        <ImageView style="@style/MenuRowChevron" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/rowPrivacy"
        style="@style/MenuRow">
        <FrameLayout style="@style/MenuRowIconBg">
            <ImageView style="@style/MenuRowIcon" android:src="@drawable/ic_privacy" />
        </FrameLayout>
        <TextView style="@style/MenuRowText" android:text="Privacy Policy" />
        <ImageView style="@style/MenuRowChevron" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/rowAdConsent"
        style="@style/MenuRow">
        <FrameLayout style="@style/MenuRowIconBg">
            <ImageView style="@style/MenuRowIcon" android:src="@drawable/ic_ad_consent" />
        </FrameLayout>
        <TextView style="@style/MenuRowText" android:text="Manage Ad Consent" />
        <ImageView style="@style/MenuRowChevron" />
    </LinearLayout>

</LinearLayout>
