<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="210dp"
    android:layout_margin="6dp"
    android:background="@drawable/card_gradient_border"
    android:padding="2dp">

    <com.google.android.material.imageview.ShapeableImageView
        android:id="@+id/promptImage"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/image_placeholder"
        android:scaleType="centerCrop"
        app:shapeAppearanceOverlay="@style/RoundedCardImage" />

    <!-- Bottom scrim for title + category + bookmark button -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="72dp"
        android:layout_gravity="bottom"
        android:background="@drawable/card_scrim_bg"
        android:gravity="bottom"
        android:orientation="vertical"
        android:paddingStart="10dp"
        android:paddingEnd="44dp"
        android:paddingBottom="10dp">

        <TextView
            android:id="@+id/promptTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="@color/white"
            android:textSize="12.5sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/promptCategory"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="1dp"
            android:textColor="@color/text_secondary"
            android:textSize="10.5sp" />
    </LinearLayout>

    <ImageButton
        android:id="@+id/bookmarkIcon"
        android:layout_width="34dp"
        android:layout_height="34dp"
        android:layout_gravity="bottom|end"
        android:layout_margin="8dp"
        android:background="@drawable/heart_circle_bg"
        android:padding="6dp"
        android:src="@drawable/ic_bookmark_border" />

</FrameLayout>
